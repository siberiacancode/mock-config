{
  "name": "mock-config-docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "prod": "next build && node server.ts",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "type": "tsc --noEmit",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@siberiacancode/reactuse": "^1.0.11",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.1",
    "fumadocs-twoslash": "^3.3.0",
    "fumadocs-ui": "16.14.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "twoslash": "^0.3.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/serve-handler": "^6.1.4",
    "mock-config-server": "5.0.0-beta.4",
    "postcss": "^8.5.25",
    "serve-handler": "^6.1.7",
    "tailwindcss": "^4.3.3"
