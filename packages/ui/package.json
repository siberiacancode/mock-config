{
  "name": "mock-config-inspector",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "UI inspector for mock-config-server configuration",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "homepage": "https://github.com/siberiacancode/mock-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siberiacancode/mock-config-server.git"
  },
  "bugs": {
    "url": "https://github.com/siberiacancode/mock-config/issues"
  },
  "keywords": [
    "mock",
    "inspector",
    "ui",
    "config",
    "devtools"
  ],
  "bin": {
    "mock-config-inspector": "dist/bin/bin.mjs",
    "mci": "dist/bin/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "config": {
    "inspectorPort": "7777"
  },
  "scripts": {
    "dev": "pnpm run \"/^mci:/\"",
    "build": "vite build --emptyOutDir && tsdown",
    "start": "pnpm build && node ./dist/bin/bin.mjs",
    "mci:server": "nodemon --watch src --watch bin -e js,ts --exec \"pnpm start --port $npm_package_config_inspectorPort\"",
    "mci:app": "vite",
    "mci:mock": "mcs --watch",
    "preview": "vite preview",
    "type": "tsc --noEmit && tsc --noEmit -p app/tsconfig.app.json",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "ansi-colors": "^4.1.3",
    "esbuild": "^0.24.2",
    "get-port-please": "^3.2.0",
    "h3": "^1.15.4",
    "mrmime": "^2.0.0",
    "open": "^11.0.0",
    "please-upgrade-node": "^3.2.0",
    "ws": "^8.20.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@siberiacancode/reactuse": "^1.0.9",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "mock-config-server": "workspace:*",
    "nodemon": "^3.1.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.2",
    "tsdown": "^0.22.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  },
  "lint-staged": {
    "*.css": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --no-error-on-unmatched-pattern --fix",
      "prettier --write"
    ]
  }
}
