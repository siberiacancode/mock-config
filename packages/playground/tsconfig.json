{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@siberiacancode/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@/shared/*": ["../shared/*"],
      "@/core/*": ["./src/core/*"],
      "@/utils/*": ["./src/utils/*"]
    },
    "sourceMap": true
  },
  "exclude": ["node_modules"]
}
