    "@types/node": "^25.5.0",
    "@types/supertest": "^6.0.3",
    "@types/yargs": "^17.0.35",
    "ansi-colors": "^4.1.3",
    "express": "^4.22.1",
    "supertest": "^7.2.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
