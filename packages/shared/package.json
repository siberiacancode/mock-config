{
  "name": "mock-config-shared",
  "keywords": [
    "mock",
    "playground",
    "json-server",
    "rest",
    "fake-api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "type": "tsc --noEmit",
    "format": "prettier --write .",
    "pretty": "pnpm type && pnpm lint && pnpm format",
    "unit-test": "vitest",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@siberiacancode/tsconfig": "^1.2.0",
    "@siberiacancode/vitest": "^2.4.1",
    "@types/node": "^25.5.0",
    "ansi-colors": "^4.1.3",
    "express": "^4.22.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
