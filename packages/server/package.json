{
  "name": "mock-config-server",
  "version": "5.0.0-beta.2",
  "description": "Tool that easily and quickly imitates server operation, create full fake api in few steps",
  "author": {
    "name": "SIBERIA CAN CODE 🧊",
    "url": "https://github.com/siberiacancode"
  },
  "license": "MIT",
  "homepage": "https://github.com/siberiacancode/mock-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siberiacancode/mock-config-server.git"
  },
  "bugs": {
    "url": "https://github.com/siberiacancode/mock-config/issues"
  },
  "keywords": [
    "server",
    "fake",
    "REST",
    "rest",
    "API",
    "api",
    "mock",
    "mocking",
    "config",
    "data"
  ],
  "main": "dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "mock-config-server": "dist/bin/bin.mjs",
    "mcs": "dist/bin/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepublishOnly": "git diff --exit-code",
    "lint-staged": "lint-staged",
    "prepare": "husky && pnpm build",
    "build": "tsdown",
    "start": "pnpm build && node ./dist/bin/bin.mjs",
    "dev": "nodemon --watch src --watch bin --watch mock-server.config.* -e js,ts --exec \"pnpm start\"",
    "type": "tsc --noEmit",
    "unit-test": "vitest",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector",
    "format": "prettier --write \"**/*.(ts|js)\"",
    "pretty": "pnpm lint && pnpm format"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.33",
    "ansi-colors": "^4.1.3",
    "body-parser": "^2.0.2",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-urlrewrite": "^2.0.3",
    "flat": "^6.0.1",
    "graphql": "^16.10.0",
    "please-upgrade-node": "^3.2.0",
    "prompts": "^2.4.2",
    "ws": "^8.20.0",
    "yargs": "^17.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@siberiacancode/vitest": "^2.4.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --no-error-on-unmatched-pattern --fix",
      "prettier --write"
    ]
  }
}
